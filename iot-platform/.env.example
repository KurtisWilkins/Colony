# =============================================================================
# IoT Platform Configuration
# Copy this file to .env and update values for your environment
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iot_platform
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=changeme_password

# --- MQTT Broker (Local Mosquitto) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# --- Master Pi (for Mosquitto bridge) ---
# Set these to the master Pi's IP and MQTT port for bridging
MASTER_PI_HOST=192.168.1.100
MASTER_PI_PORT=1883

# --- Flask API Server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Application Secret Key (used for session signing) ---
# IMPORTANT: Change this to a random string in production!
SECRET_KEY=change-me-to-a-random-secret-in-production

# --- Login Credentials (single-user session auth) ---
LOGIN_USERNAME=KurtisWilkins
LOGIN_PASSWORD=ChooseAStrongPasswordHere

# --- Git Auto-Update ---
GIT_REPO_URL=https://github.com/KurtisWilkins/Colony.git
GIT_BRANCH=main

# --- No-IP Dynamic DNS ---
# Configure via: sudo bash scripts/setup-noip.sh

# --- Node Environment ---
NODE_ENV=production
